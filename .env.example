# ── App ──────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://pod.star7gaurav.in
NEXT_PUBLIC_SITE_NAME="Print Studio"
NEXT_PUBLIC_SITE_LOGO_PATH="assets/logo.png"
NEXT_PUBLIC_ANNOUNCEMENT_TEXT="Custom Apparel & Promotional Products — Free Shipping on Every Order"
NEXT_PUBLIC_CONTACT_PHONE="+91 000-000-0000"
NEXT_PUBLIC_CONTACT_EMAIL="hello@example.com"
NEXT_PUBLIC_CONTACT_ADDRESS=""
NEXT_PUBLIC_FOOTER_DESCRIPTION="Custom apparel design and production for teams, events, and businesses."
NEXT_PUBLIC_HOME_META_TITLE="Design Custom Apparel Online"
NEXT_PUBLIC_HOME_META_DESCRIPTION="Design custom shirts, jerseys, and branded apparel online with real-time 3D preview."
NEXT_PUBLIC_HOME_OG_IMAGE_PATH="assets/logo.png"

# ── Database (MySQL) ──────────────────────────────────────────────────────────
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="mysql://pod_user:CHANGE_ME@127.0.0.1:3306/pod_db"

# ── NextAuth ──────────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
AUTH_SECRET=CHANGE_ME_32_CHAR_SECRET
NEXTAUTH_SECRET=CHANGE_ME_32_CHAR_SECRET

# ── Shopify App ───────────────────────────────────────────────────────────────
# Create app at: https://partners.shopify.com → Apps → Create app
SHOPIFY_API_KEY=your_shopify_api_key
SHOPIFY_API_SECRET=your_shopify_api_secret
SHOPIFY_SCOPES=read_products,write_products,read_orders,write_orders,read_themes

# ── Razorpay ─────────────────────────────────────────────────────────────────
# Dashboard: https://dashboard.razorpay.com
RAZORPAY_KEY_ID=rzp_test_XXXX
RAZORPAY_KEY_SECRET=XXXX
RAZORPAY_WEBHOOK_SECRET=XXXX
# Create plans in Razorpay dashboard → Subscriptions → Plans
RAZORPAY_PLAN_STARTER=plan_XXXX
RAZORPAY_PLAN_PRO=plan_XXXX

# ── Cloudflare R2 Storage ─────────────────────────────────────────────────────
R2_ACCOUNT_ID=60821f434df3a45fb32e42dbd8df7bb4
R2_BUCKET_NAME=print-on-demand
R2_ACCESS_KEY_ID=XXXX
R2_SECRET_ACCESS_KEY=XXXX
# r2.dev public URL or custom domain for the bucket
R2_PUBLIC_URL=https://pub-XXXX.r2.dev

# ── Print Partner ─────────────────────────────────────────────────────────────
# Use Printrove for India, Printful for international
PRINTFUL_API_KEY=
PRINTROVE_API_KEY=
PRINTROVE_API_URL=https://api.printrove.com/api
